<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="Musica" Height="600" Width="1000"
        MinHeight="480" MinWidth="800"
        Icon="/Resources/vinyl.ico">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.ColumnSpan="2" Grid.Row="0">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_Library">
                    <MenuItem Header="_New..." />
                    <MenuItem Header="_Open..." />
                    <MenuItem Header="_Save" Command="Save"/>
                </MenuItem>
                <MenuItem Header="Songs">
                    <MenuItem Header="_Import..."/>
                    <MenuItem Header="_Edit..."/>
                    <MenuItem Header="_Delete" Command="Delete"/>
                </MenuItem>
                <MenuItem Header="_Playlist">
                    <MenuItem Header="_New" Click="OpenAddWindow"/>
                </MenuItem>
            </Menu>
            <TextBox AcceptsReturn="True" />
        </DockPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" Background="{StaticResource BrushBackground}">
            <TextBlock FontSize="18" Padding="7" Margin="10" Foreground="White"><Bold>All Songs</Bold></TextBlock>
        </StackPanel>
        <Grid Grid.Row="1" Grid.Column="1"></Grid>
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource BgBrush2}"/>
    </Grid>
</Window>
