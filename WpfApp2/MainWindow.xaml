<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        xmlns:vm="clr-namespace:WpfApp2.ViewModels"
        xmlns:views="clr-namespace:WpfApp2.Views"
        mc:Ignorable="d"
        Title="Musica" Height="600" Width="1000"
        MinHeight="480" MinWidth="800"
        Icon="/Resources/vinyl.ico">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
            <views:WelcomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SongListViewModel}">
            <views:SongListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistViewModel}">
            <views:PlaylistView/>
        </DataTemplate>

        <Style x:Key="LoadedOnlyVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLibraryLoaded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.ColumnSpan="2" Grid.Row="0">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_Library">
                    <MenuItem Header="_New..." Command="{Binding CreateLibraryCommand}" />
                    <MenuItem Header="_Open..." Command="{Binding OpenLibraryCommand}" />
                    <MenuItem Header="_Save" Command="{Binding SaveLibraryCommand}"/>
                </MenuItem>
                <MenuItem Header="Songs" IsEnabled="{Binding IsLibraryLoaded}">
                    <MenuItem Header="_Import..." Command="{Binding ImportSongsCommand}"/>
                    <MenuItem Header="_Edit..." Command="{Binding EditSongCommand}"/>
                    <MenuItem Header="_Delete" Command="{Binding DeleteSongCommand}"/>
                </MenuItem>
                <MenuItem Header="_Playlist" IsEnabled="{Binding IsLibraryLoaded}">
                    <MenuItem Header="_New..." Command="{Binding OpenAddPlaylistCommand}"/>
                </MenuItem>
            </Menu>
            <TextBox AcceptsReturn="True" />
        </DockPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" Background="{StaticResource BrushBackground}" Style="{StaticResource LoadedOnlyVisibilityStyle}">
            <Button Command="{Binding ShowSongListCommand}" Margin="10" Padding="7" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
                <TextBlock FontSize="18" Foreground="White"><Bold>All Songs</Bold></TextBlock>
            </Button>
            <Grid Margin="10,0,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="14" Foreground="White" VerticalAlignment="Center"><Bold>Playlists</Bold></TextBlock>
                <Button Grid.Column="1"
                        Width="22"
                        Height="22"
                        Content="+"
                        FontWeight="Bold"
                        Background="{StaticResource AccB}"
                        BorderThickness="0"
                        Command="{Binding OpenAddPlaylistCommand}"/>
            </Grid>
            <ListBox x:Name="PlaylistsList"
                     Margin="10,0,10,10"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="White"
                     ItemsSource="{Binding Playlists}"
                     SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,4"/>
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Rename"
                                              Command="{Binding PlacementTarget.Tag.RenamePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Delete"
                                              Command="{Binding PlacementTarget.Tag.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccB}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                                
                                Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="36"
                                        Height="36"
                                        CornerRadius="6"
                                        ClipToBounds="True"
                                        Background="#557A7A7A">
                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Text="{Binding Name}"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <ContentControl Grid.Row="1"
                        Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Style="{StaticResource LoadedOnlyVisibilityStyle}"/>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource BgBrush2}" Style="{StaticResource LoadedOnlyVisibilityStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="4" Background="#557A7A7A" ClipToBounds="True">
                    <Image Stretch="UniformToFill" Source="{Binding Player.CurrentSongCoverPath}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Foreground="White" FontSize="14" FontWeight="Bold" Text="{Binding Player.CurrentSongTitle}"/>
                    <TextBlock Foreground="#D0D0D0" FontSize="12" Text="{Binding Player.CurrentSongArtist}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Margin="8,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="❮❮" Command="{Binding Player.PreviousCommand}" Foreground="White" FontSize="18" Margin="8,0" Background="Transparent" BorderThickness="0"/>
                    <Button Content="{Binding Player.PlayPauseText}" Command="{Binding Player.PlayPauseCommand}" Foreground="White" FontSize="16" Margin="8,0" Background="Transparent" BorderThickness="0"/>
                    <Button Content="❯❯" Command="{Binding Player.NextCommand}" Foreground="White" FontSize="18" Margin="8,0" Background="Transparent" BorderThickness="0"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Player.PositionText}" Foreground="#D0D0D0" VerticalAlignment="Center" FontSize="12"/>
                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding Player.DurationSeconds}"
                            Value="{Binding Player.PositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Height="14"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Player.RemainingText}" Foreground="#D0D0D0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="🔊" Foreground="White" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <Slider Width="90" Minimum="0" Maximum="100" Value="{Binding Player.Volume, Mode=TwoWay}" Height="14" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Content="{Binding WelcomePage}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLibraryLoaded}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</Window>
