<Window x:Class="WpfApp2.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="Playlist" Height="220" Width="360"
        ResizeMode="NoResize"
        Icon="/Resources/vinyl.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" Grid.Row="1">
            <Border Background="LightGray" Width="80" Height="80">
                <Image x:Name="Preview" Stretch="UniformToFill"/>
            </Border>
            <Border Background="Transparent" CornerRadius="15" Height="10"/>
            <Button Width="80" Click="BrowseAndAdd">Browse</Button>
        </StackPanel>
        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="1">
            <TextBlock Grid.Row="0" Text="Name" FontSize="14" Foreground="Gray" />
            <Border Background="Transparent" Height="5"/>
            <TextBox Grid.Row="1" Width="180" Height="30" HorizontalAlignment="Left"/>
        </StackPanel>


        <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">

            <Button Click="Cancel" Margin="10" Width="60" Height="20">Cancel</Button>
            <Button Click="AddPlaylist" Margin="10" Width="60" Height="20" Background="{StaticResource AccB}">Add</Button>

        </StackPanel>
    </Grid>
</Window>