<Application x:Class="WpfApp2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfApp2"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Bg1" >#084a80</Color>
            <Color x:Key="Bg2">#03192b</Color>
            <Color x:Key="Accent">#edbe00</Color>
            <SolidColorBrush x:Key="AccB" Color="{StaticResource Accent}"/>
            <SolidColorBrush x:Key="BgBrush2" Color="{StaticResource Bg2}"/>
            <LinearGradientBrush x:Key="BrushBackground">
                <GradientStop Offset="0.1" Color="{StaticResource Bg1}" />
                <GradientStop Offset="1" Color="{StaticResource Bg2}" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>